# Copy this file to .env and fill in real values before running in production.

# Secret used to sign login sessions (tokens). Set this to a long random string.
JWT_SECRET=change-this-to-a-long-random-string

# Your MongoDB connection string. For a free hosted database, create a
# free M0 cluster at https://www.mongodb.com/cloud/atlas/register, then
# grab the connection string from Atlas → Connect → Drivers.
# Example: mongodb+srv://myuser:mypassword@cluster0.xxxxx.mongodb.net/rankquest
MONGODB_URI=

# Your Anthropic API key. Used for AI scoring / quest chains / Oracle insights
# unless a Grok key is set below. Without either key, the app still works but
# falls back to local, non-AI point estimates.
ANTHROPIC_API_KEY=

# Alternative: use xAI's Grok instead of Claude for the AI features.
# If GROK_API_KEY is set (and ANTHROPIC_API_KEY is not), the app uses Grok
# automatically. To force one or the other regardless of which keys are set,
# set AI_PROVIDER=grok or AI_PROVIDER=anthropic.
GROK_API_KEY=
GROK_MODEL=grok-4.3
AI_PROVIDER=

# Port the server listens on (most hosts set this automatically).
PORT=3000
